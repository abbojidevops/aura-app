# Copy to .env and fill in. Never commit .env.

# Public domain for HTTPS (Caddy gets the certificate automatically). Point DNS A/AAAA here first.
DOMAIN=aura.example.com

# PostgreSQL password for the bundled database container.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Media storage: "local" (uploads volume) or "s3" (S3-compatible bucket).
STORAGE=local

# Only needed when STORAGE=s3. Cloudflare R2 example: S3_REGION=auto and S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=aura-media
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=0

# Public URL that serves media (the bucket's public URL or your CDN). Required when STORAGE=s3.
# MEDIA_BASE_URL=https://media.aura.example.com
